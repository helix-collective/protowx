# to enable these aliases run;
# git config --local include.path ../.gitshared

[alias]
  st = status --short --branch
  stn = status --short --branch --untracked-files=no
  ls = log --pretty=format:%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn] --decorate --date=short --abbrev=10
  lg = log --pretty=format:%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn] --decorate --date=format:'%Y%m%d-%H:%M' --graph --all --abbrev=10
  lgo = log --pretty=format:%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn] --decorate --date=format:'%Y%m%d-%H:%M' --graph --all --reflog --abbrev=10
  lgd = log --pretty=format:%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn] --decorate --date=format:'%Y%m%d-%H:%M' --graph --all --simplify-by-decoration
  co = checkout

  # update worktree pointer without checkout
  # git symbolic-ref HEAD refs/heads/$BRANCH

  # update where branch points to
  # git update-ref refs/heads/$BRANCH $COMMIT
  mainupdateref = update-ref refs/heads/main HEAD
  movemain = update-ref refs/heads/main origin/main
