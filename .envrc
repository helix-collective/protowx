# The dev shell.
#
# Two variables build a tool from a local checkout, in place of the
# commit flake.lock pins:
#
#   REPO_TOOLS_DEV  a wxio/repo-tools checkout, for the git hooks
#   OHM_GO_DEV      an ohmjs/ohm-go checkout, for ohm-cli
#
# Give each an absolute path, or one relative to this directory. Set
# them outside this repository: your shell, or .envrc.local, which
# .gitignore holds. No tracked file changes either way, so a switch
# between the modes leaves the worktree clean.
#
# docs/devtools/nix-custom-dev-tools.md section 8 is the page.

# The workspace's go.work, when there is one and it names this
# checkout: the starter then builds against the library checkouts
# beside it. A lone clone has no ../go.work, and a worktree is not
# named in it, so each keeps its own. The workspace page
# docs/structure/workspace-structure.md, section 4, is the map.
# It is set before .envrc.local is read, so GOWORK=off there wins.
# The shell banner says which go.work is in use.
if [ -f ../go.work ] && grep -q "./$(basename "$PWD")/engine" ../go.work; then
  export GOWORK="$(cd .. && pwd)/go.work"
fi

source_env_if_exists .envrc.local

overrides=()

# direnv reloads when a tools flake changes. It does not watch the Go
# sources: a reload is a full rebuild, and you do not want one on every
# keystroke. Run `direnv reload` when you want the new build.
if [ -n "${REPO_TOOLS_DEV:-}" ]; then
  watch_file "$REPO_TOOLS_DEV/flake.nix"
  overrides+=(--override-input repo-tools "path:$REPO_TOOLS_DEV")
fi
if [ -n "${OHM_GO_DEV:-}" ]; then
  watch_file "$OHM_GO_DEV/flake.nix"
  overrides+=(--override-input ohm-go "path:$OHM_GO_DEV")
fi

use flake . "${overrides[@]}"
