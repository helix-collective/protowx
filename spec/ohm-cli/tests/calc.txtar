(Exp 0-11 'OP1 + 2CP * 3'
  (AddExp 0-11 'OP1 + 2CP * 3'
    (MulExp 0-11 'OP1 + 2CP * 3'
      (MulExp_times 0-11 'OP1 + 2CP * 3'
        (MulExp 0-7 'OP1 + 2CP'
          (PriExp 0-7 'OP1 + 2CP'
            (PriExp_paren 0-7 'OP1 + 2CP'
              (Exp 1-6 '1 + 2'
                (AddExp 1-6 '1 + 2'
                  (AddExp_plus 1-6 '1 + 2'
                    (AddExp 1-2 '1'
                      (MulExp 1-2 '1'
                        (PriExp 1-2 '1'
                          (number 1-2 '1'
                          )
                        )
                      )
                    )
                    (MulExp 5-6 '2'
                      (PriExp 5-6 '2'
                        (number 5-6 '2'
