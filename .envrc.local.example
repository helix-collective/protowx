# Copy to .envrc.local to build a tool from a local checkout instead of
# the commit flake.lock pins: the git hooks from repo-tools, and ohm-cli
# from ohm-go. Each line is one tool; comment out a line to go back to
# its pin.
#
#   cp .envrc.local.example .envrc.local && direnv reload
#
# The shell banner then reads "LOCAL, from REPO_TOOLS_DEV" and "LOCAL,
# from OHM_GO_DEV". Delete .envrc.local and reload to go back to the
# pins.
#
# .envrc resolves these paths from the repository root, whatever
# directory you are in, because direnv always reads .envrc from beside
# itself. The values below are the protowx-workspace layout, where
# the repositories are siblings. Use an absolute path for any other
# layout.
#
# docs/devtools/nix-custom-dev-tools.md section 8 is the page.
#
# In the workspace, .envrc points GOWORK at ../go.work. Set GOWORK
# here to turn that off for this checkout: "$PWD/go.work" keeps this
# checkout's own file, and "off" reads no go.work at all.
#
# TS_AUTHKEY and TS_DOMAIN are for the compose stack's tailnet node;
# docs/devtools/compose-tailscale.md is the page.
#
# TS_AUTHKEY_EXPIRE is the key's expiry date, YYYYMMDD. The console
# shows it when you make the key, and the key does not carry it, so
# write it down here. task compose:authkey counts the days left. It
# warns from a week before, and task compose:up refuses to start
# after. Leave it out and nothing is checked.
#
# The NGROK_ lines are the second stack, deploy/ngrok, which puts the
# same two services on the public internet in place of a tailnet.
# docs/devtools/compose-ngrok.md is the page.
#
#   NGROK_AUTHTOKEN    the agent's credential. One token serves every
#                      endpoint of your account, and it does not expire.
#   NGROK_DOMAIN       the page's domain, with no https:// and no path.
#                      A free account has one, on ngrok-free.dev.
#   NGROK_MYW_DOMAIN   a second domain, for My Whisper. Leave it out and
#                      the page draws no dictate button. A free account
#                      has one domain, so leave it out there.
#   NGROK_OAUTH_EMAIL  the addresses SSO lets in, separated by commas.
#                      LEAVE IT OUT AND THE PAGE IS OPEN: anyone with
#                      the URL reaches the engine API and your
#                      calculations. The tailnet is the guard in the
#                      other stack; here SSO is.
#
# task fastdev -- ngrok checks these three and starts the stack.

# export GOWORK="$PWD/go.work"
# export REPO_TOOLS_DEV=../tools
# export OHM_GO_DEV=../ohm-go

# https://dashboard.ngrok.com/get-started/your-authtoken
export NGROK_AUTHTOKEN=xxx
# https://dashboard.ngrok.com/domains
export NGROK_DOMAIN=XXXX.ngrok-free.dev
# export NGROK_MYW_DOMAIN=XXXX-myw.ngrok-free.dev
# export NGROK_OAUTH_EMAIL=you@example.com

export TS_AUTHKEY=tskey-auth-xxxx
export TS_AUTHKEY_EXPIRE=YYYYMMDD
export TS_DOMAIN=tailbXXXXX.ts.net
